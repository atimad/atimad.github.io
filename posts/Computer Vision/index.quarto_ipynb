      "source": [
        "---\n",
        "title: \"ML QA Computer Vision Assessment\"\n",
        "author: \"Atila Madai\"\n",
        "date: 2025-06-22\n",
        "categories: [Computer Vision, notebook, python]\n",
        "tags: [python, notebook]\n",
        "# 1) Tell Quarto which Python to use:\n",
        "jupyter:\n",
        "  kernelspec:\n",
        "    name: python3\n",
        "    display_name: \"Python 3\"\n",
        "    language: python\n",
        "\n",
        "format:\n",
        "  html:\n",
        "    code-fold: true\n",
        "    toc: true\n",
        "    toc-location: left\n",
        "    page-layout: article\n",
        "    #css: styles.scss\n",
        "\n",
        "# 2) Freeze existing outputs (don’t re-run):\n",
